#!/bin/sh
# LxBox CLI Management Utility for Keenetic (Entware)
# Part of LxBox for Keenetic

CONFIG_FILE="/opt/etc/lxbox/config.json"
INIT_SCRIPT="/opt/etc/init.d/S99lxbox"
LOG_FILE="/opt/var/log/lxbox.log"
HELPER_BIN="/opt/bin/lxbox-helper"
CORE_BIN="/opt/sbin/sing-box"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

get_router_ip() {
    ip -4 addr show br0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1 || echo "192.168.1.1"
}

is_running() {
    if [ -f /opt/var/run/lxbox.pid ]; then
        PID=$(cat /opt/var/run/lxbox.pid 2>/dev/null)
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
    fi
    pidof sing-box >/dev/null 2>&1
}

cmd_status() {
    echo -e "${CYAN}=== LxBox System Status ===${NC}"
    if is_running; then
        PID=$(cat /opt/var/run/lxbox.pid 2>/dev/null || pidof sing-box | awk '{print $1}')
        MEM=$(ps | grep "$PID" | grep -v grep | awk '{print $3}' 2>/dev/null)
        echo -e "Status:     ${GREEN}● RUNNING${NC} (PID: $PID)"
        [ -n "$MEM" ] && echo -e "Memory:     $MEM VSZ"
    else
        echo -e "Status:     ${RED}○ STOPPED${NC}"
    fi

    echo -e "\n${CYAN}--- Web & Network Ports ---${NC}"
    echo -e "Web Management: ${GREEN}http://$(get_router_ip):9095${NC} (Import links & subscriptions)"
    echo -e "Dashboard UI:   ${CYAN}http://$(get_router_ip):9090/ui${NC} (MetaCubeXD node switcher)"
    echo -e "Clash API:      http://$(get_router_ip):9090"
    echo -e "Mixed Proxy:    127.0.0.1:7890 (SOCKS5/HTTP)"
    echo -e "SOCKS5:         127.0.0.1:10808"

    if which ndmc >/dev/null 2>&1; then
        if ndmc -c "show interface Proxy0" 2>/dev/null | grep -q "Proxy0"; then
            echo -e "Keenetic Proxy0: ${GREEN}● ACTIVE${NC} (Available in Connection Priorities & HydraRoute)"
        else
            echo -e "Keenetic Proxy0: ${YELLOW}○ NOT CONFIGURED${NC} (run 'lxbox iface add' to enable)"
        fi
    fi

    if [ -f "$CONFIG_FILE" ]; then
        echo -e "\n${CYAN}--- Active Outbounds ---${NC}"
        grep -E '"tag"|"type"' "$CONFIG_FILE" | grep -B1 '"type": "vless"' -A1 2>/dev/null || true
    fi
}

cmd_import() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: link parameter is required!${NC}"
        echo "Usage: lxbox import '<happ_or_vless_or_subscription_link>'"
        exit 1
    fi

    echo -e "${YELLOW}[*] Parsing and importing configuration...${NC}"
    if [ -x "$HELPER_BIN" ]; then
        "$HELPER_BIN" import "$1" -c "$CONFIG_FILE"
        RET=$?
        if [ $RET -eq 0 ]; then
            echo -e "${GREEN}[+] Link successfully imported into $CONFIG_FILE${NC}"
            if is_running; then
                echo -e "${YELLOW}[*] Reloading LxBox service...${NC}"
                "$INIT_SCRIPT" restart
            else
                echo -e "${YELLOW}[*] Starting LxBox service...${NC}"
                "$INIT_SCRIPT" start
            fi
            echo -e "${GREEN}[✔] Open Web Dashboard to select node: http://$(get_router_ip):9090/ui${NC}"
        else
            echo -e "${RED}[-] Failed to import link (code: $RET)${NC}"
            exit $RET
        fi
    else
        echo -e "${RED}Error: $HELPER_BIN not found or not executable!${NC}"
        exit 1
    fi
}

cmd_test() {
    echo -e "${YELLOW}[*] Testing connection through local proxy (127.0.0.1:7890)...${NC}"
    TIME=$(curl -x http://127.0.0.1:7890 -s -o /dev/null -w "%{time_total}s" https://www.google.com/generate_204 2>/dev/null)
    if [ $? -eq 0 ] && [ -n "$TIME" ]; then
        echo -e "${GREEN}[✔] Proxy connection OK! Latency: $TIME${NC}"
    else
        echo -e "${RED}[✘] Connection failed or timeout! Make sure LxBox is running and an active outbound node is selected.${NC}"
    fi
}

cmd_web() {
    echo -e "${GREEN}=== Web Interfaces ===${NC}"
    echo -e "  Management & Import UI: ${CYAN}http://$(get_router_ip):9095${NC}"
    echo -e "  MetaCubeXD Dashboard:   ${CYAN}http://$(get_router_ip):9090/ui${NC}"
    echo -e "  AWG Manager:            ${CYAN}http://$(get_router_ip):2222${NC}\n"
    echo "Tips: Open http://$(get_router_ip):9095 to import Happ/VLESS links directly in your browser!"
}

cmd_iface() {
    ARG1="$1"
    ARG2="$2"
    
    IDX=0
    ACTION="status"

    if [ "$ARG1" -ge 0 ] 2>/dev/null && [ "$ARG1" -le 5 ] 2>/dev/null; then
        IDX="$ARG1"
        ACTION="${ARG2:-status}"
    else
        ACTION="${ARG1:-status}"
        if [ "$ARG2" -ge 0 ] 2>/dev/null && [ "$ARG2" -le 5 ] 2>/dev/null; then
            IDX="$ARG2"
        fi
    fi

    IFNAME="Proxy$IDX"
    PORT=$((10808 + IDX))
    DESC="LxBox"
    if [ "$IDX" -eq 0 ]; then
        DESC="LxBox Master (Failover Pool)"
    else
        DESC="LxBox Sub-$IDX"
    fi

    if ! which ndmc >/dev/null 2>&1; then
        echo -e "${RED}Error: 'ndmc' utility not found. This command must be run on KeeneticOS!${NC}"
        return 1
    fi

    case "$ACTION" in
        add|enable|on)
            echo -e "${YELLOW}[*] Configuring KeeneticOS interface $IFNAME for $DESC (127.0.0.1:$PORT)...${NC}"
            ndmc -c "interface $IFNAME" >/dev/null 2>&1
            ndmc -c "interface $IFNAME description \"$DESC\"" >/dev/null 2>&1
            ndmc -c "interface $IFNAME proxy proto socks5" >/dev/null 2>&1
            ndmc -c "interface $IFNAME proxy upstream 127.0.0.1 $PORT" >/dev/null 2>&1
            ndmc -c "interface $IFNAME proxy socks5-udp" >/dev/null 2>&1
            ndmc -c "interface $IFNAME ip global auto" >/dev/null 2>&1
            ndmc -c "interface $IFNAME up" >/dev/null 2>&1
            ndmc -c "system configuration save" >/dev/null 2>&1
            echo -e "${GREEN}[✔] Interface $IFNAME created and enabled!${NC}"
            echo -e "Now $IFNAME is visible in KeeneticOS Connection Priorities, HydraRoute Neo, and AWG Manager."
            ;;
        del|disable|off|remove)
            echo -e "${YELLOW}[*] Removing KeeneticOS interface $IFNAME...${NC}"
            ndmc -c "no interface $IFNAME" >/dev/null 2>&1
            ndmc -c "system configuration save" >/dev/null 2>&1
            echo -e "${GREEN}[✔] Interface $IFNAME removed from KeeneticOS.${NC}"
            ;;
        status|show|*)
            echo -e "${CYAN}=== Keenetic Interfaces (Proxy0..Proxy5) ===${NC}"
            for i in 0 1 2 3 4 5; do
                P="Proxy$i"
                PRT=$((10808 + i))
                STATUS=$(ndmc -c "show interface $P" 2>/dev/null)
                if echo "$STATUS" | grep -q "$P" && ! echo "$STATUS" | grep -q "unable to find"; then
                    echo -e "  $P (port $PRT): ${GREEN}● ACTIVE${NC}"
                else
                    echo -e "  $P (port $PRT): ${YELLOW}○ NOT CONFIGURED${NC}"
                fi
            done
            echo -e "\nUsage: lxbox iface [0-5] [add|del]"
            ;;
    esac
}

case "$1" in
    import)
        shift
        cmd_import "$@"
        ;;
    status)
        cmd_status
        ;;
    start)
        "$INIT_SCRIPT" start
        ;;
    stop)
        "$INIT_SCRIPT" stop
        ;;
    restart)
        "$INIT_SCRIPT" restart
        ;;
    reload)
        "$INIT_SCRIPT" restart
        ;;
    check)
        "$CORE_BIN" check -c "$CONFIG_FILE"
        ;;
    log|logs)
        tail -n 50 -f "$LOG_FILE"
        ;;
    web|ui)
        cmd_web
        ;;
    iface|interface)
        shift
        cmd_iface "$@"
        ;;
    test)
        cmd_test
        ;;
    uninstall)
        if [ -f /opt/etc/lxbox/uninstall.sh ]; then
            /bin/sh /opt/etc/lxbox/uninstall.sh
        else
            echo "Uninstaller script not found."
        fi
        ;;
    *)
        echo -e "${CYAN}==========================================${NC}"
        echo -e "${GREEN}      LxBox for Keenetic Router           ${NC}"
        echo -e "${CYAN}==========================================${NC}"
        cmd_status
        echo -e "\n${YELLOW}Commands:${NC}"
        echo "  lxbox import '<link>'   - Import Happ, VLESS, Hy2, AWG, or sub link"
        echo "  lxbox web               - Show Web UI and dashboard links"
        echo "  lxbox iface [add|del]   - Manage KeeneticOS Proxy0 network interface"
        echo "  lxbox test              - Test proxy connectivity"
        echo "  lxbox start             - Start LxBox service"
        echo "  lxbox stop              - Stop LxBox service"
        echo "  lxbox restart           - Restart LxBox service"
        echo "  lxbox check             - Check configuration syntax"
        echo "  lxbox log               - View live service logs"
        echo "  lxbox status            - Show service status"
        echo "  lxbox uninstall         - Uninstall LxBox"
        echo -e "${CYAN}==========================================${NC}"
        ;;
esac
